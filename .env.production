# Production client env. VITE_* vars are baked into the browser bundle at build
# time (Vite reads this file in production mode), so the public URLs MUST be set
# here, not only as runtime k8s env (runtime env reaches SSR but not the browser).
VITE_BASE_URL="https://keystone.omni.dev"
VITE_API_BASE_URL="https://api.keystone.omni.dev"
VITE_AUTH_BASE_URL="https://identity.omni.dev"
VITE_ACCOUNT_URL="https://account.omni.dev"
VITE_BILLING_BASE_URL="https://api.billing.omni.dev"
VITE_AUTHZ_API_URL="https://api.access.omni.dev"

# Server-side secrets/config are provided at runtime via k8s env, not baked here.
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""

# feature flags
VITE_FLAGS_API_HOST=https://flags.omni.dev/api
# Hosted publishing (live sites + custom domains on Arbor/Fractal). Off until
# Arbor's git host opens to users; while off the builder offers preview links
# only. Flip to "true" (and enable it in keystone-api) when Arbor launches.
VITE_HOSTED_PUBLISH_ENABLED="false"
